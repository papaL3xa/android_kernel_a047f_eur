#Loadable Kernel Module support
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=n
CONFIG_MODULE_SIG=n
CONFIG_MODULE_COMPRESS=n
CONFIG_TRIM_UNUSED_KSYMS=n

#customizations
CONFIG_DEFAULT_HOSTNAME="a04s"

#kallsyms
CONFIG_KALLSYMS_ALL=y

#disable anti-root features
CONFIG_UH=n
CONFIG_SECURITY_DEFEX=n

#wireguard
CONFIG_WIREGUARD=y
CONFIG_WIREGUARD_DEBUG=n

# Enable KSU
CONFIG_KSU=y
CONFIG_KSU_WITH_KPOBES=n
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_ALLOWLIST_WORKAROUND=y
